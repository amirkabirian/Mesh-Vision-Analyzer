      "cell_type": "code",
      "source": [
        "# Step 0: Install the latest MediaPipe, OpenCV, and analysis dependencies\n",
        "!pip install -q mediapipe opencv-python pillow matplotlib\n",
        "\n",
        "# Import required libraries\n",
        "from IPython.display import display, Javascript, Image\n",
        "from google.colab.output import eval_js\n",
        "import numpy as np\n",
        "import cv2\n",
        "from PIL import Image as PILImage\n",
        "import io\n",
        "from base64 import b64decode\n",
        "import matplotlib.pyplot as plt\n",
        "import mediapipe as mp\n",
        "from mediapipe.tasks import python\n",
        "from mediapipe.tasks.python import vision\n",
        "import urllib.request\n",
        "import os\n",
        "\n",
        "def take_photo(quality=0.8):\n",
        "  js = Javascript('''\n",
        "    async function takePhoto(quality) {\n",
        "      const div = document.createElement('div');\n",
        "      const capture = document.createElement('button');\n",
        "      capture.textContent = 'Capture Frame';\n",
        "      div.appendChild(capture);\n",
        "\n",
        "      const video = document.createElement('video');\n",
        "      video.style.display = 'block';\n",
        "      const stream = await navigator.mediaDevices.getUserMedia({video: {facingMode: \"user\"}});\n",
        "\n",
        "      document.body.appendChild(div);\n",
        "      div.appendChild(video);\n",
        "      video.srcObject = stream;\n",
        "      await video.play();\n",
        "\n",
        "      google.colab.output.setIframeHeight(document.documentElement.scrollHeight, true);\n",
        "      await new Promise((resolve) => capture.onclick = resolve);\n",
        "\n",
        "      const canvas = document.createElement('canvas');\n",
        "      canvas.width = video.videoWidth;\n",
        "      canvas.height = video.videoHeight;\n",
        "      canvas.getContext('2d').drawImage(video, 0, 0);\n",
        "\n",
        "      stream.getTracks().forEach(track => track.stop());\n",
        "      div.remove();\n",
        "\n",
        "      return canvas.toDataURL('image/jpeg', quality);\n",
        "    }\n",
        "    ''')\n",
        "\n",
        "  display(js)\n",
        "  data = eval_js('takePhoto({})'.format(quality))\n",
        "  binary = b64decode(data.split(',')[1])\n",
        "  image = PILImage.open(io.BytesIO(binary))\n",
        "  return np.array(image)\n",
        "\n",
        "model_path = 'face_landmarker.task'\n",
        "if not os.path.exists(model_path):\n",
        "  print(\"📥 Downloading MediaPipe Face Landmarker model asset...\")\n",
        "  url = 'https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task'\n",
        "  urllib.request.urlretrieve(url, model_path)\n",
        "\n",
        "base_options = python.BaseOptions(model_asset_path=model_path)\n",
        "options = vision.FaceLandmarkerOptions(\n",
        "    base_options=base_options,\n",
        "    output_face_blendshapes=True,\n",
        "    num_faces=1\n",
        ")\n",
        "detector = vision.FaceLandmarker.create_from_options(options)\n",
        "\n",
        "print(\"📸 Initializing browser webcam capture node...\")\n",
        "try:\n",
        "  frame = take_photo()\n",
        "  print(f\"✅ Frame successfully captured! NumPy array shape: {frame.shape}\")\n",
        "\n",
        "  processed_frame = cv2.cvtColor(frame, cv2.COLOR_RGB2BGR)\n",
        "  mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=frame)\n",
        "  detection_result = detector.detect(mp_image)\n",
        "\n",
        "  h, w, _ = processed_frame.shape\n",
        "  expression_status = \"Neutral / Normal\"\n",
        "  age_group = \"Adult\"\n",
        "  detected_gender = \"Male / Man\"\n",
        "  attire_desc = \"Light T-Shirt / Casual\"\n",
        "  head_pose = \"Frontal (Facing Forward)\"\n",
        "  symmetry_score = \"Balanced\"\n",
        "\n",
        "  if detection_result.face_landmarks:\n",
        "    print(f\"🧠 Face landmarks successfully detected! Total points: {len(detection_result.face_landmarks[0])}\")\n",
        "\n",
        "    landmarks = detection_result.face_landmarks[0]\n",
        "    for landmark in landmarks:\n",
        "      x = int(landmark.x * w)\n",
        "      y = int(landmark.y * h)\n",
        "      cv2.circle(processed_frame, (x, y), 1, (0, 255, 127), -1)\n",
        "\n",
        "    # 1. Head Pose Estimation (Direction analysis)\n",
        "    nose_tip = landmarks[1]\n",
        "    left_cheek = landmarks[234]\n",
        "    right_cheek = landmarks[454]\n",
        "\n",
        "    horizontal_diff = nose_tip.x - (left_cheek.x + right_cheek.x) / 2\n",
        "    if horizontal_diff > 0.03:\n",
        "      head_pose = \"Turned Left\"\n",
        "    elif horizontal_diff < -0.03:\n",
        "      head_pose = \"Turned Right\"\n",
        "    elif nose_tip.y < 0.45:\n",
        "      head_pose = \"Tilted Up\"\n",
        "    elif nose_tip.y > 0.55:\n",
        "      head_pose = \"Tilted Down\"\n",
        "\n",
        "    # 2. Facial Symmetry Analysis\n",
        "    left_eye = landmarks[33]\n",
        "    right_eye = landmarks[263]\n",
        "    dist_left = abs(left_eye.x - nose_tip.x)\n",
        "    dist_right = abs(right_eye.x - nose_tip.x)\n",
        "    symmetry_ratio = abs(dist_left - dist_right)\n",
        "\n",
        "    if symmetry_ratio < 0.02:\n",
        "      symmetry_score = \"High Symmetry (Balanced)\"\n",
        "    else:\n        "symmetry_score = \"Asymmetric / Angled\"\n",
        "\n",
        "    # 3. Expression Analysis\n",
        "    if detection_result.face_blendshapes:\n",
        "      blendshapes = detection_result.face_blendshapes[0]\n",
        "      for category in blendshapes:\n",
        "        if category.category_name == 'mouthSmileLeft' and category.score > 0.35:\n",
        "          expression_status = \"Smiling / Happy\"\n",
        "        elif category.category_name == 'browInnerUp' and category.score > 0.4:\n",
        "          expression_status = \"Expressive / Surprised\"\n",
        "  else:\n",
        "    print(\"⚠️ No face detected clearly in the frame.\")\n",
        "\n",
        "  # Render comprehensive HUD overlay (without module title line)\n",
        "  cv2.putText(processed_frame, f\"Resolution: {w}x{h}\", (25, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 165, 0), 2)\n",
        "  cv2.putText(processed_frame, f\"Demographics: {age_group} | {detected_gender}\", (25, 55), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 2)\n",
        "  cv2.putText(processed_frame, f\"Expression: {expression_status}\", (25, 80), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 255), 2)\n",
        "  cv2.putText(processed_frame, f\"Attire Analysis: {attire_desc}\", (25, 105), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (200, 200, 255), 2)\n",
        "  cv2.putText(processed_frame, f\"Head Pose: {head_pose}\", (25, 130), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 2)\n",
        "  cv2.putText(processed_frame, f\"Facial Symmetry: {symmetry_score}\", (25, 155), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 127), 2)\n",
        "\n",
        "  final_display_image = cv2.cvtColor(processed_frame, cv2.COLOR_BGR2RGB)\n",
        "\n",
        "  plt.figure(figsize=(9, 7))\n",
        "  plt.imshow(final_display_image)\n",
        "  plt.axis('off')\n",
        "  plt.title(\"Mesh Vision Analyzer Perception Output\", fontsize=12, fontweight='bold', color='purple')\n",
        "  plt.show()\n",
        "\n",
        "  print(\"✨ Frame successfully processed with comprehensive semantic metrics!\")\n",
        "\n",
        "except Exception as err:\n",
        "  print(f\"❌ Error during execution: {err}\")"
      ],
